{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare debug build directory",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Build Howl (Debug)",
            "type": "shell",
            "command": "g++ -std=c++17 -g \"${workspaceFolder}\"/*.cpp -o \"${workspaceFolder}/build/howl\"",
            "dependsOn": "Prepare debug build directory",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
